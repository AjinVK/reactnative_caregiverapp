{
  "expo": {
    "name": "care_giver",
    "slug": "care_giver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/caregiver.png",
    "scheme": "caregiver",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ajin_vk.care_giver",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "caregiver",
              "host": "hospital"
            },
            {
              "scheme": "https",
              "host": "caregiver.expo.app",
              "pathPrefix": "/hospital"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/caregiver.png"
    },
    "extra": {
      "router": {
        "origin": "https://caregiver.in"
      },
      "eas": {
        "projectId": "62cdfd07-4303-4cd3-bce0-b81b34c3070a"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-router",
        {
          "origin": "https://caregiver.in"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}